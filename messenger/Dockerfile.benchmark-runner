FROM messenger-service-local:dev

USER root
WORKDIR /app

COPY requirements-benchmark.txt /tmp/requirements-benchmark.txt
RUN pip install --no-cache-dir -r /tmp/requirements-benchmark.txt

# Return to non-root app user from the main Messenger image.
USER appuser

# Important: this runner image must not use messenger docker_entrypoint.py.
ENTRYPOINT ["python"]
CMD ["--version"]
